# Copy to .env and fill in. Never commit real keys.
# This demo refuses sk_live_ / rk_live_ keys and live-mode webhook events.

DATABASE_URL=postgres://payments:payments@localhost:5432/payments
PORT=3000

# fake: in-process gateway, no Stripe account required (docker-compose default)
# test: Stripe test mode via a restricted key (rk_test_...)
STRIPE_MODE=fake
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_dev_only_placeholder

# Shared secret for /v1/jobs/* (reconciliation and outbox drain)
JOB_TOKEN=dev-job-token

# Nightly ledger vs Stripe event reconciliation (UTC). Off unless true.
ENABLE_SCHEDULER=false
RECONCILE_CRON=0 2 * * *

# Publishes outbox rows with backoff. The API process polls; tests leave this off.
ENABLE_OUTBOX_POLLER=true
OUTBOX_POLL_MS=2000
